# ---------------------------------------------------------------------------
# Undal HomeKitchen — repository ignore contract
# Anything listed here is either generated by CI or must never be committed.
# ---------------------------------------------------------------------------

# Gradle / build output
.gradle/
build/
*/build/
!gradle/wrapper/gradle-wrapper.jar
captures/
.gradletasknamecache
local.properties

# Android artefacts (the signed APK lives on GitHub Releases, never in git)
*.apk
*.aab
*.ap_
*.dex
*.class
.cxx/
output.json

# Firebase config JSON is injected by CI from the GOOGLE_SERVICES_JSON secret.
app/google-services.json

# Signing material — keystores are generated once by .github/workflows/keystore.yml
*.jks
*.keystore
keystore.properties
.env

# Worker dependencies and Wrangler local state
node_modules/
wrangler.toml.bak
.wrangler/
worker/dist/
worker/.dev.vars

# IDE / editor
.idea/
*.iml
*.hprof
.vscode/
.DS_Store
Thumbs.db

# NOTE: app/src/main/res/raw/undal_order_alert.mp3 is intentionally NOT ignored —
# the bootstrap workflow commits the official order sound into res/raw so that
# every later build (local or CI) resolves R.raw.undal_order_alert.

# Python bytecode from the gate scripts
__pycache__/
*.pyc

# Wrangler build output
worker/dist/

# Cloudflare Pages output — written by `cd worker && npm run build:web`, which
# renders every public page with the real router. Generated, never committed.
web/public/
