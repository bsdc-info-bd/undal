# ---------------------------------------------------------------------------
# Undal customer website — Cloudflare Pages response headers
#
# These apply to the files in `web/public`. The Pages Function sets its own
# headers on everything it renders (the same set, from `worker/src/util/http.ts`),
# so a page served from a snapshot and a page served from a render carry the same
# protections — `web/src/serve.ts` merges `securityHeaders()` into snapshots for
# exactly that reason.
# ---------------------------------------------------------------------------

# The artwork changes only when a deploy changes it, and a deploy changes the
# bytes, so it can be cached hard.
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# The one file that must never be cached. A stale service worker is a site that
# keeps serving yesterday's pages after a fix, on every phone that installed it.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Read by the Function once per isolate to learn which snapshots exist and when
# they were written; a deploy replaces it, so it must not outlive one.
/prerender-manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
