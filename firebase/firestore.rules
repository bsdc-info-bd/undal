rules_version = '2';

// ===========================================================================
// Undal HomeKitchen — Firestore security contract (PART G3)
//
// Principles
//  1. Money is never trusted from the client shape alone: totals must equal
//     subtotal + delivery - discount, every amount is a non-negative int (paisa).
//  2. The customer writes their order exactly once, with status == 'placed'.
//     There is no customer update path at all, so self-cancellation is
//     impossible by construction (LAW / C-077).
//  3. The vendor moves orders along the state machine only, appending exactly
//     one timeline entry per transition, and never touches money fields.
//  4. Everything the delivery radius, km-fee and schedule depend on is
//     validated on write.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // helpers
    // ----------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isVendor() {
      return signedIn() && request.auth.token.vendor == true;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.superAdmin == true;
    }

    // A migration gate, not a client preference. It starts false for the
    // original single store. The super-admin migration can turn it on only
    // after legacy records have received their default branchId and every
    // active staff account has explicit branch claims. Before activation an
    // empty assignment keeps legacy default access; afterwards it has none.
    function branchIsolationEnabled() {
      return exists(/databases/$(database)/documents/config/store)
        && get(/databases/$(database)/documents/config/store).data.get('branchIsolationEnabled', false) == true;
    }

    function legacyGlobalVendor() {
      return isVendor() && !branchIsolationEnabled()
        && request.auth.token.get('branchIds', []).size() == 0;
    }

    function assignedBranch(branchId) {
      let branch = branchId is string && branchId.size() > 0 ? branchId : 'default';
      let assignments = request.auth.token.get('branchIds', []);
      return isSuperAdmin() || (isVendor() &&
        ((branch == 'default' && assignments.size() == 0 && !branchIsolationEnabled())
         || assignments.hasAny([branch, '*'])));
    }

    function canManageMenuBranch(branchId) {
      let branch = branchId is string && branchId.size() > 0 ? branchId : '*';
      let assignments = request.auth.token.get('branchIds', []);
      return isSuperAdmin() || (isVendor() &&
        ((branch == '*' && assignments.size() == 0 && !branchIsolationEnabled())
         || assignments.hasAny([branch, '*'])));
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }

    function isPositiveInt(value) {
      return value is int && value > 0;
    }

    function nonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function nonBlankString(value) {
      return value is string && value.size() >= 3;
    }

    function fullAddress() {
      return request.resource.data.address.keys().hasAll(['lat', 'lng', 'title', 'desc', 'note'])
        && request.resource.data.address.lat is number
        && request.resource.data.address.lng is number
        && request.resource.data.address.lat >= -90 && request.resource.data.address.lat <= 90
        && request.resource.data.address.lng >= -180 && request.resource.data.address.lng <= 180
        && nonBlankString(request.resource.data.address.title)
        && nonBlankString(request.resource.data.address.desc)
        && nonBlankString(request.resource.data.address.note);
    }

    // --- order state machine (PART G4) --------------------------------------
    function statusTransitionAllowed(from, to) {
      return (from == 'placed' && (to == 'accepted' || to == 'cancelled'))
        || (from == 'accepted' && (to == 'ready' || to == 'cancelled'))
        || (from == 'ready' && to == 'in_delivery')
        || (from == 'in_delivery' && to == 'delivered');
    }

    // One new timeline entry per transition. Ordering is positional, and the
    // machine-checked part is the last element's status. Per-step times live in
    // the dedicated server-stamped fields (acceptedAt, readyAt, inDeliveryAt,
    // deliveredAt) because a server-timestamp transform cannot be nested inside
    // an arrayUnion element — so the rules do not ask for one there.
    function timelineAppendedOneFor(newStatus) {
      let timeline = request.resource.data.timeline;
      return timeline.size() == resource.data.timeline.size() + 1
        && timeline[timeline.size() - 1].keys().hasOnly(['status'])
        && timeline[timeline.size() - 1].status == newStatus;
    }

    function acceptTransitionValid() {
      return request.resource.data.prepMinutes is int
        && request.resource.data.prepMinutes > 0
        && request.resource.data.prepMinutes <= 180
        && request.resource.data.prepEndsAt is timestamp
        && request.resource.data.prepEndsAt > request.time;
    }

    function cancelTransitionValid() {
      return nonBlankString(request.resource.data.cancelNote);
    }

    function deliverTransitionValid() {
      return request.resource.data.collectedAmountPaisa is int
        && request.resource.data.collectedAmountPaisa == resource.data.totalAmountPaisa;
    }

    function vendorTransitionValid() {
      let to = request.resource.data.status;
      let from = resource.data.status;
      return from != 'delivered'
        && from != 'cancelled'
        && statusTransitionAllowed(from, to)
        && timelineAppendedOneFor(to)
        && request.resource.data.updatedAt == request.time
        && (to != 'accepted' || acceptTransitionValid())
        && (to != 'cancelled' || cancelTransitionValid())
        && (to != 'delivered' || deliverTransitionValid())
        && onlyChanged([
             'status', 'prepMinutes', 'prepEndsAt', 'cancelNote', 'vendorNote',
             'timeline', 'updatedAt', 'collectedAmountPaisa',
             'acceptedAt', 'readyAt', 'inDeliveryAt', 'deliveredAt'
           ]);
    }

    // ======================================================================
    // users/{uid} — the customer profile, one document per customer
    // ======================================================================
    match /users/{userId} {
      // A branch order contains everything the kitchen may see. Never trade a
      // customer's private address book/profile for a convenience photo read.
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
             'name', 'email', 'phone', 'address', 'role', 'fcmSub', 'createdAt'
           ])
        && nonBlankString(request.resource.data.name)
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.role == 'customer'
        && fullAddress()
        && request.resource.data.createdAt == request.time
        && request.resource.data.address.note.size() <= 300
        && request.resource.data.address.desc.size() <= 300;
      allow update: if isOwner(userId)
        && !changedKeys().hasAny(['role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.name.size() <= 80
        && request.resource.data.address.keys().hasAll(['lat', 'lng', 'title', 'desc', 'note'])
        && nonBlankString(request.resource.data.address.title)
        && nonBlankString(request.resource.data.address.desc)
        && nonBlankString(request.resource.data.address.note)
        && request.resource.data.address.lat is number
        && request.resource.data.address.lng is number;
      allow delete: if isOwner(userId);
    }

    // ======================================================================
    // users/{uid}/addresses/{addressId} — the saved address book (web + app)
    //
    // A customer keeps up to a dozen pins: home, office, a relative's house.
    // Each one is a full address in its own right (lat/lng plus the three text
    // lines an order needs), validated exactly like the address on the profile
    // document, so a saved pin can be dropped onto an order without a second
    // round of checks. The count itself is capped in the Worker, which is the
    // only place that can see the whole collection at once; the rules keep the
    // shape honest and the book private to its owner.
    // ======================================================================
    match /users/{userId}/addresses/{addressId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
             'label', 'title', 'desc', 'note', 'lat', 'lng', 'createdAt'
           ])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && nonBlankString(request.resource.data.title)
        && nonBlankString(request.resource.data.desc)
        && nonBlankString(request.resource.data.note)
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 40
        && request.resource.data.title.size() <= 160
        && request.resource.data.desc.size() <= 300
        && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && !changedKeys().hasAny(['createdAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && nonBlankString(request.resource.data.title)
        && nonBlankString(request.resource.data.desc)
        && nonBlankString(request.resource.data.note)
        && request.resource.data.label.size() <= 40
        && request.resource.data.title.size() <= 160
        && request.resource.data.desc.size() <= 300
        && request.resource.data.note.size() <= 300;
    }

    // ======================================================================
    // vendor/{vendorUid} — the single kitchen identity
    // ======================================================================
    match /vendor/{vendorId} {
      allow get: if isOwner(vendorId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      // branchIds and disabled are server-managed authorization data. The
      // Worker trusts them for alert fan-out, so a staff device must never be
      // able to assign itself to another kitchen by editing this document.
      allow create, update: if isSuperAdmin()
        && request.resource.data.role == 'vendor'
        && nonBlankString(request.resource.data.name);
      allow delete: if false;
    }

    // ======================================================================
    // fcmTokens/{uid}/tokens/{token} — device registration, self-serve only
    // ======================================================================
    match /fcmTokens/{userId}/tokens/{token} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['platform', 'updatedAt', 'appVersion'])
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }

    // ======================================================================
    // Menu catalogue — public to read (the web store renders it), vendor writes
    // ======================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && nonBlankString(request.resource.data.name)
        && request.resource.data.order is int;
      allow delete: if canManageMenuBranch(resource.data.get('branchId', '*'));
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow create, update: if canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && request.resource.data.categoryId is string
        && nonBlankString(request.resource.data.name)
        && request.resource.data.order is int;
      allow delete: if canManageMenuBranch(resource.data.get('branchId', '*'));
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && nonBlankString(request.resource.data.name)
        && request.resource.data.categoryId is string
        && isPositiveInt(request.resource.data.amountPaisa)
        && request.resource.data.amountPaisa <= 1000000
        && request.resource.data.available is bool
        && request.resource.data.veg is bool
        && request.resource.data.spiceLevel is int
        && request.resource.data.spiceLevel >= 0
        && request.resource.data.spiceLevel <= 3
        && request.resource.data.tags is list
        && request.resource.data.orderCount is int
        && request.resource.data.createdAt == request.time;
      allow update: if canManageMenuBranch(resource.data.get('branchId', '*'))
        && canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && isPositiveInt(request.resource.data.amountPaisa)
        && request.resource.data.amountPaisa <= 1000000
        && request.resource.data.available is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if canManageMenuBranch(resource.data.get('branchId', '*'));
    }

    match /combos/{comboId} {
      allow read: if true;
      allow create: if canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && nonBlankString(request.resource.data.name)
        && request.resource.data.itemRefs is list
        && request.resource.data.itemRefs.size() >= 2
        // rules.List has no all() - the rules language cannot inspect every
        // element of a list, so per-item detail is not expressible here.
        && isPositiveInt(request.resource.data.amountPaisa)
        && isPositiveInt(request.resource.data.regularAmountPaisa)
        && request.resource.data.amountPaisa <= request.resource.data.regularAmountPaisa;
      allow update: if canManageMenuBranch(resource.data.get('branchId', '*'))
        && canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && request.resource.data.itemRefs is list
        && request.resource.data.itemRefs.size() >= 2
        // rules.List has no all() - the rules language cannot inspect every
        // element of a list, so per-item detail is not expressible here.
        && isPositiveInt(request.resource.data.amountPaisa)
        && isPositiveInt(request.resource.data.regularAmountPaisa)
        && request.resource.data.amountPaisa <= request.resource.data.regularAmountPaisa;
      allow delete: if canManageMenuBranch(resource.data.get('branchId', '*'));
    }

    // ======================================================================
    // Campaigns — vendor owned, public to read (home banners follow instantly)
    // ======================================================================
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update: if canManageMenuBranch(request.resource.data.get('branchId', '*'))
        && nonBlankString(request.resource.data.title)
        && (request.resource.data.type == 'percent' || request.resource.data.type == 'fixed')
        && isPositiveInt(request.resource.data.value)
        && !(request.resource.data.type == 'percent' && request.resource.data.value > 90)
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt;
      allow delete: if canManageMenuBranch(resource.data.get('branchId', '*'));
    }

    // ======================================================================
    // Coupons — never listable: read a code only while signed in.
    // Customers may perform the ONE atomic usage increment the checkout
    // transaction performs; the vendor owns every other field.
    // ======================================================================
    match /coupons/{code} {
      allow get: if signedIn();
      allow list: if legacyGlobalVendor()
        || (isVendor() && assignedBranch(resource.data.get('branchId', '*')));
      allow create: if canManageMenuBranch(request.resource.data.get('branchId', '*'));
      allow delete: if canManageMenuBranch(resource.data.get('branchId', '*'));
      // A customer's order spends one use: `usedCount` goes up by exactly one
      // and nothing else changes.
      //
      // `usageLimit` 0 — or absent — means UNLIMITED. That is the default every
      // coupon is created with, and this rule used to demand
      // `usedCount < usageLimit`, i.e. `0 < 0`: every unlimited coupon refused the
      // whole order transaction in the app. A coupon renamed by an older build
      // carries no `usedCount` at all, which made `usedCount + 1` an error and
      // refused it too. The expiry is only judged here when it is a timestamp;
      // the order path judges every other shape with the shared coupon rule.
      allow update: if canManageMenuBranch(resource.data.get('branchId', '*'))
        && canManageMenuBranch(request.resource.data.get('branchId', '*'));
    }

    // ======================================================================
    // Orders — create once as the customer, advance as the vendor
    // ======================================================================
    match /orders/{orderId} {
      allow get: if legacyGlobalVendor() || assignedBranch(resource.data.get('branchId', 'default'))
        || (signedIn() && resource.data.customerId == uid());
      allow list: if signedIn() && request.query.limit <= 150
        && (legacyGlobalVendor() || assignedBranch(resource.data.get('branchId', 'default'))
            || resource.data.customerId == uid());
      // Checkout is server-only: /api/store/order verifies the Firebase caller,
      // branch coverage, live menu prices, fees, coupon and counter before using
      // the service account. A client must never be able to invent its own bill.
      allow create: if false;
      allow update: if assignedBranch(resource.data.get('branchId', 'default')) && vendorTransitionValid();
      allow delete: if false;
    }

    // ======================================================================
    // chats/{orderId} — Firestore-side metadata only; messages live in RTDB
    // ======================================================================
    match /chats/{orderId} {
      allow read: if legacyGlobalVendor() || assignedBranch(resource.data.get('branchId', 'default'))
        || (signedIn() && resource.data.customerId == uid());
      allow create: if false;
      allow update: if assignedBranch(resource.data.get('branchId', 'default'))
        && onlyChanged(['lastVendorReadAt', 'lastCustomerReadAt', 'updatedAt']);
      allow delete: if false;
    }

    // ======================================================================
    // notifInbox/{uid}/items/{itemId} — in-app history, owner only
    // ======================================================================
    match /notifInbox/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && nonBlankString(request.resource.data.title)
        && request.resource.data.read is bool
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && onlyChanged(['read']);
      allow delete: if isOwner(userId);
    }

    // ======================================================================
    // branches/{branchId} — one vendor, many independently operated kitchens
    // ======================================================================
    match /branches/{branchId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (assignedBranch(branchId)
        && onlyChanged([
          'name', 'storeName', 'open', 'openSynced', 'acceptingOrders', 'autoClosed',
          'autoClosedReason', 'autoClosedAt', 'autoRestoredAt', 'autoClosedSilentMinutes',
          'manualOverrideNote', 'weekly', 'specialDates', 'deliveryPerKmAmountPaisa',
          'radiusKm', 'coverage', 'coveragePolygon', 'minOrderAmountPaisa', 'storeLat',
          'storeLng', 'storeAddressText', 'serviceAreas', 'bannerUrl', 'logoUrl',
          'reopenedAt', 'scheduleSyncedAt', 'updatedAt', 'updatedBy'
        ]));
    }

    // Customer requests to extend the nearest branch's delivery area.
    match /deliveryRequests/{requestId} {
      allow get: if isSuperAdmin() || (signedIn() &&
        (resource.data.customerId == uid() || assignedBranch(resource.data.branchId)));
      allow list: if isSuperAdmin();
      allow create: if signedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.branchId is string
        && request.resource.data.address.lat is number
        && request.resource.data.address.lng is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Branch staff can see and act on the operational alert in the vendor app,
      // but only the super admin may change coverage or approve/reject a request.
      allow update, delete: if isSuperAdmin();
    }

    match /auditLog/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ======================================================================
    // config/store · config/promos — world readable, vendor writable
    // ======================================================================
    match /config/{docId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isVendor()
        && request.resource.data.get('branchIsolationEnabled', false) == false);
      allow update: if isSuperAdmin() || (isVendor()
        && !changedKeys().hasAny(['branchIsolationEnabled']));
      allow delete: if false;
    }

    // ======================================================================
    // counters/orders — the shortId generator (atomic +1 inside checkout)
    // ======================================================================
    // One document per Dhaka date: five-minute online/offline samples and the
    // day's outage windows, written by the Worker's presence sweep and read by
    // the kitchen's dashboard for its uptime analytics. Customers never read it.
    match /presenceDays/{dateKey} {
      // The Android dashboard reads deterministic per-branch document ids.
      // Collection-wide vendor history queries would mix kitchens and are not
      // authorized; super-admin tooling may still list them explicitly.
      allow get: if legacyGlobalVendor() || assignedBranch(resource.data.get('branchId', 'default'));
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if false;
    }

    // Everything not declared above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
