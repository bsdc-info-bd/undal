<?xml version="1.0" encoding="utf-8"?>
<!--
  Undal HomeKitchen — application manifest.

  PART I-7 permission block is complete from Response 1 so that every later
  background service (order alert, prep timer, heartbeat, boot receiver)
  installs with its permissions already granted by the OS on first launch.
  Components are declared in the response that ships their class.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- location: mandatory for delivery radius + km-based fee -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- notifications + background survival -->
    <!--
        MODIFY_AUDIO_SETTINGS is a normal permission: granted at install, never
        prompted. It is what lets the alert raise the ALARM stream when an order
        arrives on a phone whose alarm volume is at zero — the one state in which
        a fully armed kitchen rings with nothing audible.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phone calls are placed with ACTION_DIAL, so CALL_PHONE is never requested. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".UndalApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Undal"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Undal.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: verified https links served by the Undal Worker. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${undalWorkerHost}" />
            </intent-filter>

            <!-- Custom scheme fallback used by the Worker smart-open page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="undal" />
            </intent-filter>
        </activity>

        <!-- ================================================================ -->
        <!-- Background services that make a locked phone ring (PART I)        -->
        <!-- ================================================================ -->

        <!-- Loops the official order sound at alarm volume until the order is
             answered, with a full-screen intent and a partial wake lock. -->
        <service
            android:name=".core.background.OrderAlertService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="order-alerts" />
        </service>

        <!-- The live order watcher: a Firestore listener in the foreground, so an
             order rings this phone even when push does not arrive at all. Silent
             notification on purpose — this is a fallback, not a delivery guarantee. -->
        <service
            android:name=".core.background.KitchenWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="order-watch" />
        </service>

        <!-- Sticky prep countdown with the ten-second tick. -->
        <service
            android:name=".core.background.PrepTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="prep-countdown" />
        </service>

        <!-- Kitchen presence heartbeat: keeps the Worker's auto-offline rule honest. -->
        <service
            android:name=".core.background.PresenceHeartbeatService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="kitchen-presence" />
        </service>

        <!-- The alert watchdog: an alarm the system holds on Undal's behalf, so a
             kitchen phone whose app was swiped away or killed by a battery
             cleaner rebuilds its order watcher without anyone opening anything.
             Never armed on a customer phone. -->
        <receiver
            android:name=".core.background.AlertWatchdogReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.undal.syl.app.action.ALERT_WATCHDOG" />
            </intent-filter>
        </receiver>

        <!-- Brings the heartbeat, the token registration and the channels back
             after a reboot, an app update or a timezone change. -->
        <receiver
            android:name=".core.background.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Push entry point. High-priority data messages can wake a terminated
             process and reach this callback while locked, subject to Android/FCM
             restrictions. Force-stopped apps must be opened by the user. -->
        <service
            android:name=".core.fcm.UndalFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Exposes the downloaded APK to the system installer in Response 5. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Defaults used when FCM hands the device a display payload. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/channel_customer_orders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_undal_mark" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/undal_brand" />
    </application>
</manifest>
