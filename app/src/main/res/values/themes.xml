<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base application theme. Compose owns all in-app styling; the Android
      theme only supplies the window background and the launch splash.
    -->
    <style name="Theme.Undal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/undal_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Undal.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/undal_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_undal_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Undal</item>
    </style>
</resources>
